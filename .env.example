# Reportes App - environment contract (see src/lib/env.ts)
# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase - project settings / API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres - Supabase connection pooler (direct connection for Drizzle)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reportes

# Session - JWT signing (openssl rand -base64 32) and callback base URL
SESSION_JWT_SECRET=
SESSION_URL=http://localhost:3000

# Resend - transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# Puppeteer - set true to reuse a system Chrome instead of downloading Chromium
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=false
