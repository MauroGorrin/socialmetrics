    "@supabase/supabase-js": "^2",
    "@supabase/ssr": "^0.12.5",
    "@tanstack/react-query": "^5",
    "recharts": "^3",
    "puppeteer": "^25",
    "resend": "^6"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@biomejs/biome": "^2",
    "vitest": "^4",
    "@vitejs/plugin-react": "^4",
    "@playwright/test": "^1",
    "drizzle-kit": "0.31.10",
