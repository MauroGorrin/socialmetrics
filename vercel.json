{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm db:migrate && pnpm build",
  "regions": ["fra1"],
  "crons": [{ "path": "/api/cron/sync-ads", "schedule": "0 6 * * *" }],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
